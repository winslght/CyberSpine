# =================================================================
# CyberSpine 本地与生产环境变量配置模版 (Environment Configuration)
# =================================================================

# 运行模式: development | test | production
CYBERSPINE_ENV=development

# 日志级别: DEBUG | INFO | WARNING | ERROR
CYBERSPINE_LOG_LEVEL=INFO

# 呼吸节律基准周期 (秒)
CYBERSPINE_BREATHING_CYCLE_SECONDS=3.5

# 感觉门控静默自适应窗口 (秒)
CYBERSPINE_INHIBITION_COOLDOWN_SECONDS=60.0

# 浅层 IO 定性嗅探超时时间 (毫秒)
CYBERSPINE_STORAGE_PROBE_TIMEOUT_MS=2.1

# 端侧 3B SLM 本地推理后端 (optional): ollama | llama.cpp | mock
CYBERSPINE_SLM_BACKEND=mock
CYBERSPINE_SLM_ENDPOINT=http://127.0.0.1:11434

# FastMCP 端口与绑定地址
CYBERSPINE_MCP_HOST=127.0.0.1
CYBERSPINE_MCP_PORT=8000
